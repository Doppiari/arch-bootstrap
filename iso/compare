#!/usr/bin/env python3
"""Compare two build records and the actual image/manifest bytes they name."""

from __future__ import annotations

import argparse
import json
import re
import runpy
import sys
from pathlib import Path
from typing import Any

_API = runpy.run_path(str(Path(__file__).with_name("build")))
Refusal = _API["Refusal"]
read_regular = _API["read_regular"]
sha256_file = _API["sha256_file"]
SAFE_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\Z")
DIGEST = re.compile(r"[0-9a-f]{64}\Z")
SUFFIXES = {".iso", ".packages.tsv", ".build.json", ".notices.tar", ".sources.tar"}


def unique_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise Refusal(f"duplicate JSON field: {key}")
        result[key] = value
    return result


def load_json(path: Path) -> dict[str, Any]:
    result = json.loads(read_regular(path), object_pairs_hook=unique_pairs)
    if not isinstance(result, dict):
        raise Refusal(f"{path}: expected an object")
    return result


def safe_file(directory: Path, name: str) -> Path:
    if not isinstance(name, str) or not SAFE_NAME.fullmatch(name):
        raise Refusal(f"unsafe artefact name: {name!r}")
    path = directory / name
    # read_regular also rejects redirected parent directories.
    read_regular_bytes(path)
    return path


def read_regular_bytes(path: Path) -> None:
    _API["regular_path"](path)


def checksum_set(directory: Path, complete: bool = True) -> dict[str, str]:
    rows = read_regular(directory / "SHA256SUMS").splitlines()
    seen: dict[str, str] = {}
    for line in rows:
        match = re.fullmatch(r"([0-9a-f]{64})  ([A-Za-z0-9][A-Za-z0-9._-]*)", line)
        if not match:
            raise Refusal("SHA256SUMS: malformed digest or unsafe filename")
        digest, name = match.groups()
        if name in seen:
            raise Refusal(f"SHA256SUMS: duplicate name {name}")
        path = safe_file(directory, name)
        if sha256_file(path) != digest:
            raise Refusal(f"{name}: checksum mismatch")
        seen[name] = digest
    if not seen:
        raise Refusal("SHA256SUMS: empty set")
    if complete:
        images = [name for name in seen if name.endswith(".iso")]
        if len(images) != 1:
            raise Refusal("SHA256SUMS: exactly one image is required")
        stem = images[0][:-4]
        if set(seen) != {stem + suffix for suffix in SUFFIXES}:
            raise Refusal("SHA256SUMS: incomplete or unexpected release artefact set")
    return seen


def bind_record(path: Path) -> dict[str, Any]:
    record = load_json(path)
    if record.get("schema_version") != 1 or record.get("mode") not in (
        "development",
        "release-candidate",
    ):
        raise Refusal(f"{path}: unsupported build record")
    if record.get("signed") is not False:
        raise Refusal(f"{path}: a build never signs")
    for field in ("image", "manifest", "notices"):
        value = record.get(field)
        if not isinstance(value, dict) or not DIGEST.fullmatch(
            str(value.get("sha256", ""))
        ):
            raise Refusal(f"{path}: missing {field} digest")
        actual = safe_file(path.parent, value.get("file"))
        if sha256_file(actual) != value["sha256"]:
            raise Refusal(f"{actual}: differs from build record")
    for field in ("inputs", "arch_bootstrap", "stage2", "environment"):
        if not isinstance(record.get(field), dict):
            raise Refusal(f"{path}: missing {field}")
    return record


def comparison(first: Path, second: Path) -> dict[str, Any]:
    if first.resolve() == second.resolve():
        raise Refusal("two distinct build records are required")
    records = [bind_record(path) for path in (first, second)]
    differences = []
    for field in ("mode", "inputs", "arch_bootstrap", "stage2", "environment"):
        if records[0][field] != records[1][field]:
            differences.append(field)
    for field in ("image", "manifest"):
        if records[0][field]["sha256"] != records[1][field]["sha256"]:
            differences.append(field)
    return {
        "schema_version": 1,
        "equal": not differences,
        "differences": differences,
        "signing_eligible": not differences
        and all(r["mode"] == "release-candidate" for r in records),
        "builds": [
            {
                "record": str(path.absolute()),
                "record_sha256": sha256_file(path),
                "image": r["image"],
                "manifest": r["manifest"],
            }
            for path, r in zip((first, second), records)
        ],
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("first", type=Path)
    parser.add_argument("second", type=Path)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    try:
        result = comparison(args.first, args.second)
        encoded = json.dumps(result, sort_keys=True, indent=2) + "\n"
        if args.output:
            with args.output.open("x") as handle:
                handle.write(encoded)
        print(encoded, end="")
        return 0 if result["equal"] else 1
    except (Refusal, OSError, ValueError, KeyError, TypeError) as error:
        print(f"refused: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
