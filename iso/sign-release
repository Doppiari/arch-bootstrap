#!/usr/bin/env python3
"""Check release eligibility before creating a detached checksum signature.

No frozen campaign pair or source-delivery arrangement is recorded yet.
This interface refuses until those independent release decisions exist.
"""

from __future__ import annotations

import argparse
import runpy
import subprocess
import sys
from pathlib import Path
from typing import Any

_API = runpy.run_path(str(Path(__file__).with_name("compare")))
_BUILD = _API["_API"]
Refusal = _API["Refusal"]


def eligible(root: Path, record_path: Path, comparison_path: Path | None) -> None:
    record = _API["bind_record"](record_path)
    if record["mode"] != "release-candidate":
        raise Refusal("development builds cannot be signed")
    if comparison_path is None:
        raise Refusal("two-build comparison is missing")
    supplied = _API["load_json"](comparison_path)
    builds = supplied.get("builds", [])
    if len(builds) != 2:
        raise Refusal("two-build comparison must name two records")
    paths = [Path(build["record"]) for build in builds]
    actual = _API["comparison"](*paths)
    if supplied != actual or not actual["equal"] or not actual["signing_eligible"]:
        raise Refusal("two-build comparison is altered or unequal")
    if record_path.resolve() not in [path.resolve() for path in paths]:
        raise Refusal("comparison does not include this build")
    commit = record["arch_bootstrap"]["commit"]
    if not _BUILD["HEX40"].fullmatch(commit):
        raise Refusal("invalid source commit")
    # Read admission and fingerprint from the embedded source revision itself.
    admission_data = _BUILD["git"](root, "show", f"{commit}:iso/admission.yml")
    inputs_data = _BUILD["git"](root, "show", f"{commit}:iso/build-inputs.yml")
    admission = _BUILD["yaml"].load(admission_data, Loader=_BUILD["UniqueKeyLoader"])
    inputs = _BUILD["yaml"].load(inputs_data, Loader=_BUILD["UniqueKeyLoader"])
    entries: dict[str, Any] = {}
    for entry in admission["packages"]:
        if entry["name"] in entries:
            raise Refusal("duplicate admission entry")
        entries[entry["name"]] = entry
    manifest = record_path.parent / record["manifest"]["file"]
    if _BUILD["judge_admission"](_BUILD["read_manifest"](manifest), entries):
        raise Refusal("installed closure is not admitted at its exact versions")
    fingerprint = inputs.get("release_key_fingerprint")
    if not isinstance(fingerprint, str) or not _BUILD["FPR"].fullmatch(fingerprint):
        raise Refusal("no release-key fingerprint recorded at C")
    keys = subprocess.run(
        [
            "gpg",
            "--no-options",
            "--batch",
            "--with-colons",
            "--list-secret-keys",
            fingerprint,
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    primary = []
    want = False
    for line in keys.stdout.splitlines():
        fields = line.split(":")
        if fields[0] == "sec":
            want = True
        elif fields[0] == "fpr" and want:
            primary.append(fields[9])
            want = False
    if keys.returncode or primary != [fingerprint]:
        raise Refusal("the exact release signing key is unavailable")
    _API["checksum_set"](record_path.parent, complete=True)
    raise Refusal(
        "no frozen campaign pair or accepted corresponding-source arrangement is recorded; "
        "S is a development pin, not a release freeze"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("record", type=Path)
    parser.add_argument("--comparison", type=Path)
    parser.add_argument(
        "--root", type=Path, default=Path(__file__).resolve().parent.parent
    )
    args = parser.parse_args()
    try:
        eligible(args.root, args.record, args.comparison)
        return 0
    except (Refusal, OSError, ValueError, TypeError, KeyError) as error:
        print(f"refused: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
